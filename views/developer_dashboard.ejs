<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PatrolLink Developer</title>
<link rel="icon" href="/images/logo.png">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0b1120;--surface:#111827;--card:#1a2332;--border:#1e293b;--text:#e2e8f0;--muted:#64748b;--accent:#3b82f6;--green:#22c55e;--red:#ef4444;--amber:#f59e0b;--purple:#8b5cf6;--teal:#14b8a6}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
.app{display:flex;min-height:100vh}
.sidebar{width:220px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.sidebar-brand{padding:18px 16px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.sidebar-brand svg{width:24px;height:24px;flex-shrink:0}
.sidebar-brand span{font-size:16px;font-weight:700}
.sidebar-nav{flex:1;padding:8px;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;color:var(--muted);text-decoration:none;font-size:13px;font-weight:500;transition:.12s;cursor:pointer;border:none;background:none;width:100%;text-align:left}
.nav-item:hover{background:var(--card);color:var(--text)}
.nav-item.active{background:var(--accent);color:#fff}
.nav-item svg{width:18px;height:18px;flex-shrink:0}
.sidebar-footer{padding:12px 16px;border-top:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px}
.main{flex:1;display:flex;flex-direction:column;max-width:calc(100vw - 220px)}
.top-bar{display:flex;align-items:center;justify-content:space-between;padding:12px 24px;border-bottom:1px solid var(--border);background:var(--surface)}
.top-bar-left{display:flex;align-items:center;gap:12px}
.top-bar-left h1{font-size:16px;font-weight:700}
.top-bar-right{display:flex;align-items:center;gap:10px}
.last-updated{font-size:11px;color:var(--muted)}
.content{padding:20px 24px;overflow-y:auto;flex:1}
.tab-pane{display:none}
.tab-pane.active{display:block}
.section{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:18px}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;font-size:14px;font-weight:600}
.section-header svg{width:18px;height:18px;margin-right:6px;flex-shrink:0}
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:24px}
.metric{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px;transition:.2s}
.metric:hover{transform:translateY(-2px);border-color:var(--accent)}
.metric-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.metric-icon svg{width:22px;height:22px}
.metric-body{display:flex;flex-direction:column;gap:1px}
.metric-value{font-size:20px;font-weight:800;line-height:1.2}
.metric-label{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted)}
.btn{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:7px;font-size:11px;font-weight:600;border:none;cursor:pointer;transition:.12s;line-height:1;text-decoration:none}
.btn svg{width:13px;height:13px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#2563eb}
.btn-success{background:var(--green);color:#fff}
.btn-success:hover{background:#16a34a}
.btn-warning{background:var(--amber);color:#000}
.btn-warning:hover{background:#d97706}
.btn-danger{background:var(--red);color:#fff}
.btn-danger:hover{background:#dc2626}
.btn-ghost{background:rgba(255,255,255,.06);color:var(--text)}
.btn-ghost:hover{background:rgba(255,255,255,.1)}
.btn-sm{padding:4px 9px;font-size:10px}
.btn-sm svg{width:11px;height:11px}
.btn-link{display:inline-flex;align-items:center;gap:4px;background:none;border:none;color:var(--muted);cursor:pointer;padding:4px 6px;border-radius:5px;font-size:11px;transition:.12s;text-decoration:none}
.btn-link:hover{background:rgba(255,255,255,.06);color:var(--text)}
.key-item{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:8px;margin-bottom:6px;background:rgba(255,255,255,.02);border:1px solid transparent;transition:.15s}
.key-item:hover{border-color:var(--border);background:rgba(255,255,255,.04)}
.key-left{display:flex;align-items:center;gap:12px}
.key-icon{width:36px;height:36px;border-radius:8px;background:rgba(59,130,246,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.key-icon svg{width:18px;height:18px;color:var(--accent)}
.key-info{display:flex;flex-direction:column;gap:2px}
.key-name{font-size:13px;font-weight:600}
.key-prefix{font-size:11px;color:var(--muted);font-family:monospace}
.key-right{display:flex;align-items:center;gap:8px}
.key-status{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.key-status.active{background:var(--green)}
.key-status.disabled{background:var(--muted)}
.empty{text-align:center;padding:32px;color:var(--muted);font-size:13px}
.empty svg{width:36px;height:36px;opacity:.3;margin-bottom:8px}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:100}
.modal-overlay.active{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px;width:460px;max-width:92vw}
.modal h2{font-size:16px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.modal-field{margin-bottom:12px}
.modal-field label{display:block;font-size:11px;font-weight:600;color:var(--muted);margin-bottom:3px}
.modal-field input{width:100%;padding:8px 10px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--text);font-size:12px;outline:none}
.modal-field input:focus{border-color:var(--accent)}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
.toast-container{position:fixed;top:16px;right:16px;z-index:999;display:flex;flex-direction:column;gap:6px}
.toast{padding:10px 16px;border-radius:8px;font-size:12px;font-weight:500;color:#fff;transform:translateX(120%);transition:transform .25s;display:flex;align-items:center;gap:8px}
.toast.show{transform:translateX(0)}
.toast-success{background:#16a34a}
.toast-error{background:#dc2626}
.key-reveal{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-top:12px}
.key-reveal .key-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.key-reveal .key-value{font-family:monospace;font-size:13px;color:var(--accent);word-break:break-all;display:flex;align-items:center;gap:8px}
.key-reveal .key-value .copy-btn{background:none;border:none;color:var(--muted);cursor:pointer;padding:4px;border-radius:4px;display:flex;flex-shrink:0}
.key-reveal .key-value .copy-btn:hover{background:rgba(255,255,255,.06);color:var(--text)}
.key-reveal .key-warning{font-size:11px;color:var(--amber);margin-top:6px;display:flex;align-items:center;gap:6px}
.org-detail{display:flex;flex-direction:column;gap:6px;padding:4px 0}
.org-detail-row{display:flex;align-items:center;padding:8px 12px;border-radius:6px;background:rgba(255,255,255,.02)}
.org-detail-row:hover{background:rgba(255,255,255,.04)}
.org-detail-label{min-width:120px;font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase}
.org-detail-value{font-size:13px}
.doc-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.doc-link{display:flex;align-items:center;gap:12px;padding:14px;border-radius:8px;border:1px solid var(--border);text-decoration:none;color:var(--text);transition:.15s}
.doc-link:hover{background:rgba(255,255,255,.04);border-color:var(--accent)}
.doc-link svg{width:20px;height:20px;color:var(--accent);flex-shrink:0}
.doc-link-info{display:flex;flex-direction:column;gap:1px}
.doc-link-title{font-size:13px;font-weight:600}
.doc-link-desc{font-size:10px;color:var(--muted)}
.shimmer{background:linear-gradient(90deg,var(--card) 25%,rgba(255,255,255,.04) 50%,var(--card) 75%);background-size:200% 100%;animation:shimmer 1.4s infinite;border-radius:6px}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.org-badge{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:6px;font-size:11px;font-weight:600;text-transform:capitalize}
.org-badge.sub{background:rgba(59,130,246,.12);color:var(--accent)}
.org-badge.status{background:rgba(34,197,94,.12);color:var(--green)}
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
</style>
</head>
<body>
<div class="app">
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      <span>PatrolLink</span>
    </div>
    <nav class="sidebar-nav">
      <button class="nav-item active" data-tab="dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>
      <button class="nav-item" data-tab="keys">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
        API Keys <span class="badge" id="keyBadge">0</span>
      </button>
      <button class="nav-item" data-tab="docs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Documentation
      </button>
      <button class="nav-item" data-tab="org">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Organization
      </button>
    </nav>
    <div class="sidebar-footer" style="flex-wrap:wrap;gap:4px">
      <div style="display:flex;align-items:center;gap:6px;width:100%">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span style="flex:1"><%= user?.first_name || 'Developer' %></span>
      </div>
      <div style="display:flex;gap:4px;width:100%;margin-top:2px">
        <a href="/" class="btn-link" title="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </a>
        <a href="/documentation" class="btn-link" title="Documentation">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </a>
        <button class="btn-link" id="logoutBtn" title="Logout" style="margin-left:auto;color:var(--red)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </button>
      </div>
    </div>
  </aside>

  <!-- Main -->
  <div class="main">
    <!-- Top Bar -->
    <div class="top-bar">
      <div class="top-bar-left">
        <h1 id="pageTitle">Dashboard</h1>
      </div>
      <div class="top-bar-right">
        <span class="last-updated" id="lastUpdated"></span>
        <button class="btn btn-ghost btn-sm" id="refreshBtn" title="Refresh">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
          Refresh
        </button>
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <!-- Dashboard Tab -->
      <div class="tab-pane active" id="tab-dashboard"></div>

      <!-- API Keys Tab -->
      <div class="tab-pane" id="tab-keys">
        <div class="section">
          <div class="section-header">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>API Keys</span>
            <button class="btn btn-primary btn-sm" id="createKeyBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Create Key
            </button>
          </div>
          <div id="keyList"></div>
        </div>
      </div>

      <!-- Documentation Tab -->
      <div class="tab-pane" id="tab-docs">
        <div class="section">
          <div class="section-header"><span><svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Quick Reference</span></div>
          <div class="doc-links">
            <a href="/documentation" class="doc-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
              <div class="doc-link-info"><span class="doc-link-title">Full Documentation</span><span class="doc-link-desc">Complete API reference and guides</span></div>
            </a>
            <a href="/documentation#backend" class="doc-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              <div class="doc-link-info"><span class="doc-link-title">API Endpoints</span><span class="doc-link-desc">All backend API routes and schemas</span></div>
            </a>
            <a href="/paywall" class="doc-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
              <div class="doc-link-info"><span class="doc-link-title">Pricing & Plans</span><span class="doc-link-desc">Subscription tiers and billing</span></div>
            </a>
          </div>
        </div>
      </div>

      <!-- Organization Tab -->
      <div class="tab-pane" id="tab-org">
        <div class="section">
          <div class="section-header"><span><svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>Organization</span></div>
          <div id="orgDetail" class="org-detail"><div class="empty"><p>Loading...</p></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Key Modal -->
<div class="modal-overlay" id="createKeyModal">
  <div class="modal">
    <h2><svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>Create API Key</h2>
    <div class="modal-field"><label>Key Name</label><input type="text" id="keyName" placeholder="e.g., Production, Staging, CI/CD" maxlength="100"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="createKeyCancelBtn">Cancel</button>
      <button class="btn btn-primary" id="createKeyConfirmBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Create</button>
    </div>
  </div>
</div>

<!-- Key Reveal Modal -->
<div class="modal-overlay" id="keyRevealModal">
  <div class="modal">
    <h2><svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>API Key Created</h2>
    <p style="font-size:12px;color:var(--muted);margin-bottom:8px">Copy this key now. You won't be able to see it again.</p>
    <div class="key-reveal">
      <div class="key-label">Your API Key</div>
      <div class="key-value">
        <span id="revealedKey"></span>
        <button class="copy-btn" id="copyKeyBtn" title="Copy to clipboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
        </button>
      </div>
      <div class="key-warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Store this key securely. It will not be shown again.
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-primary" id="keyRevealDoneBtn">Done</button>
    </div>
  </div>
</div>

<!-- Confirm Revoke Modal -->
<div class="modal-overlay" id="confirmRevokeModal">
  <div class="modal">
    <h2><svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Revoke API Key</h2>
    <p style="font-size:13px;color:var(--muted)">Are you sure you want to revoke the key <strong id="revokeKeyName" style="color:var(--text)"></strong>? Any services using it will immediately lose access.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="revokeCancelBtn">Cancel</button>
      <button class="btn btn-danger" id="confirmRevokeBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Revoke</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
const TOKEN = '<%= user?.token || "" %>';
const API = '/api/developer';
let activeTab = 'dashboard';
let pendingRevokeId = null;
let orgData = null;

// Tab switching
document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    activeTab = btn.dataset.tab;
    document.getElementById('tab-' + activeTab).classList.add('active');
    document.getElementById('pageTitle').textContent = btn.textContent.trim();
    loadTab(activeTab);
  });
});

function loadActiveTab() { loadTab(activeTab); }
function refreshActiveTab() { loadTab(activeTab); }

function loadTab(tab) {
  switch(tab) {
    case 'dashboard': loadDashboard(); break;
    case 'keys': loadKeys(); break;
    case 'org': loadOrg(); break;
  }
}

// ============ DASHBOARD ============
async function loadDashboard() {
  const container = document.getElementById('tab-dashboard');
  container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted)"><div class="shimmer" style="width:60%;height:80px;margin:0 auto"></div></div>';
  try {
    const r = await fetch(`${API}/dashboard`, { headers: { Authorization: `Bearer ${TOKEN}` } });
    const d = await r.json();
    document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
    document.getElementById('keyBadge').textContent = d.api_key_count || 0;

    container.innerHTML = `
      <div class="metrics">
        <div class="metric"><div class="metric-icon" style="background:rgba(59,130,246,.12)"><svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" style="width:22px;height:22px"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></div><div class="metric-body"><span class="metric-value" style="color:#3b82f6">${d.api_key_count}</span><span class="metric-label">API Keys</span></div></div>
        <div class="metric"><div class="metric-icon" style="background:rgba(34,197,94,.12)"><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" style="width:22px;height:22px"><polyline points="20 6 9 17 4 12"/></svg></div><div class="metric-body"><span class="metric-value" style="color:#22c55e">${d.active_keys}</span><span class="metric-label">Active Keys</span></div></div>
        <div class="metric"><div class="metric-icon" style="background:rgba(245,158,11,.12)"><svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" style="width:22px;height:22px"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div><div class="metric-body"><span class="metric-value" style="color:#f59e0b">${escapeHtml(d.org_name || '—')}</span><span class="metric-label">Organization</span></div></div>
        <div class="metric"><div class="metric-icon" style="background:rgba(139,92,246,.12)"><svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" style="width:22px;height:22px"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div><div class="metric-body"><span class="metric-value" style="color:#8b5cf6">${d.subscription_tier || 'free'}</span><span class="metric-label">Subscription</span></div></div>
      </div>
      <div class="section"><div class="section-header"><span><svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Quick Start</span></div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:12px">Use your API keys to authenticate requests to PatrolLink's API.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn btn-primary btn-sm switch-to-keys"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Create API Key</button>
          <a href="/documentation" class="btn btn-ghost btn-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>Read Docs</a>
        </div>
      </div>`;
  } catch(e) {
    container.innerHTML = '<div class="empty"><p>Failed to load dashboard</p></div>';
  }
}

function switchTab(tab) {
  document.querySelectorAll('.nav-item').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  activeTab = tab;
  document.getElementById('tab-' + tab).classList.add('active');
  document.getElementById('pageTitle').textContent = document.querySelector(`.nav-item[data-tab="${tab}"]`).textContent.trim();
  loadTab(tab);
}

// ============ API KEYS ============
async function loadKeys() {
  const container = document.getElementById('keyList');
  container.innerHTML = '<div class="shimmer" style="height:48px;margin-bottom:6px"></div><div class="shimmer" style="height:48px"></div>';
  try {
    const r = await fetch(`${API}/api-keys`, { headers: { Authorization: `Bearer ${TOKEN}` } });
    const d = await r.json();
    const keys = d.api_keys || [];
    document.getElementById('keyBadge').textContent = keys.length;
    if (!keys.length) {
      container.innerHTML = '<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg><p>No API keys yet. Create one to get started.</p><button class="btn btn-primary btn-sm create-key-empty" style="margin-top:8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Create Key</button></div>';
      return;
    }
    container.innerHTML = keys.map(k => `
      <div class="key-item">
        <div class="key-left">
          <div class="key-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></div>
          <div class="key-info">
            <span class="key-name">${escapeHtml(k.name)}</span>
            <span class="key-prefix">${escapeHtml(k.key_prefix)}··· · ${k.last_used_at ? 'Last used ' + fmtDate(k.last_used_at) : 'Never used'}</span>
          </div>
        </div>
        <div class="key-right">
          <span class="key-status ${k.enabled ? 'active' : 'disabled'}" title="${k.enabled ? 'Active' : 'Disabled'}"></span>
          <button class="btn btn-ghost btn-sm toggle-key-btn" data-key-id="${k.id}" data-enabled="${!k.enabled}">${k.enabled ? 'Disable' : 'Enable'}</button>
          <button class="btn btn-danger btn-sm revoke-key-btn" data-key-id="${k.id}" data-key-name="${escapeHtml(k.name)}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Revoke</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    container.innerHTML = '<div class="empty"><p>Failed to load API keys</p></div>';
  }
}

function openCreateKey() {
  document.getElementById('keyName').value = '';
  document.getElementById('createKeyModal').classList.add('active');
  setTimeout(() => document.getElementById('keyName').focus(), 100);
}

async function createApiKey() {
  const name = document.getElementById('keyName').value.trim();
  if (!name) { showToast('Please enter a key name', 'error'); return; }
  const btn = document.getElementById('createKeyBtn');
  btn.disabled = true; btn.textContent = 'Creating...';
  try {
    const r = await fetch(`${API}/api-keys`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${TOKEN}` },
      body: JSON.stringify({ name })
    });
    if (!r.ok) throw new Error('Failed to create key');
    const d = await r.json();
    closeModal('createKeyModal');
    document.getElementById('revealedKey').textContent = d.raw_key;
    document.getElementById('keyRevealModal').classList.add('active');
    loadKeys();
    loadDashboard();
  } catch(e) { showToast(e.message, 'error'); }
  btn.disabled = false; btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Create';
}

let copiedKey = '';
function copyKey() {
  const key = document.getElementById('revealedKey').textContent;
  navigator.clipboard.writeText(key).then(() => {
    showToast('Copied to clipboard!', 'success');
  }).catch(() => {
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = key; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
    showToast('Copied to clipboard!', 'success');
  });
}

async function toggleKey(id, enabled) {
  try {
    const r = await fetch(`${API}/api-keys/${id}/toggle`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${TOKEN}` },
      body: JSON.stringify({ enabled })
    });
    if (!r.ok) throw new Error('Failed to toggle key');
    showToast(`Key ${enabled ? 'enabled' : 'disabled'}`, 'success');
    loadKeys();
  } catch(e) { showToast(e.message, 'error'); }
}

function openRevoke(id, name) {
  pendingRevokeId = id;
  document.getElementById('revokeKeyName').textContent = name;
  document.getElementById('confirmRevokeModal').classList.add('active');
}

async function confirmRevoke() {
  if (!pendingRevokeId) return;
  const btn = document.getElementById('confirmRevokeBtn');
  btn.disabled = true; btn.textContent = 'Revoking...';
  try {
    const r = await fetch(`${API}/api-keys/${pendingRevokeId}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${TOKEN}` }
    });
    if (!r.ok) throw new Error('Failed to revoke');
    showToast('API key revoked successfully', 'success');
    closeModal('confirmRevokeModal');
    pendingRevokeId = null;
    loadKeys();
    loadDashboard();
  } catch(e) { showToast(e.message, 'error'); }
  btn.disabled = false; btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Revoke';
}

// ============ ORGANIZATION ============
async function loadOrg() {
  const container = document.getElementById('orgDetail');
  try {
    const r = await fetch(`${API}/dashboard`, { headers: { Authorization: `Bearer ${TOKEN}` } });
    const d = await r.json();
    container.innerHTML = `
      <div class="org-detail-row"><span class="org-detail-label">Name</span><span class="org-detail-value">${escapeHtml(d.org_name || '—')}</span></div>
      <div class="org-detail-row"><span class="org-detail-label">Invite Code</span><span class="org-detail-value" style="font-family:monospace">${escapeHtml(d.invite_code || '—')}</span></div>
      <div class="org-detail-row"><span class="org-detail-label">Subscription</span><span class="org-detail-value"><span class="org-badge sub">${escapeHtml(d.subscription_tier || 'free')}</span> <span class="org-badge status">${escapeHtml(d.subscription_status || 'active')}</span></span></div>
      <div class="org-detail-row"><span class="org-detail-label">Monthly Rate</span><span class="org-detail-value">$${fmt(d.monthly_rate)}</span></div>
      <div class="org-detail-row"><span class="org-detail-label">Max Guards</span><span class="org-detail-value">${d.max_guards === 0 ? 'Unlimited' : d.max_guards}</span></div>
    `;
  } catch(e) {
    container.innerHTML = '<div class="empty"><p>Failed to load organization info</p></div>';
  }
}

// ============ UTILITIES ============
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
function fmt(n) { return Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtDate(d) { if(!d) return 'N/A'; return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }
function escapeHtml(s) { if(!s) return '—'; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function showToast(msg,type) {
  const c=document.getElementById('toastContainer');
  const t=document.createElement('div'); t.className=`toast toast-${type}`;
  t.innerHTML=`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">${type==='success'?'<polyline points="20 6 9 17 4 12"/>':'<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>'}</svg>${msg}`;
  c.appendChild(t); requestAnimationFrame(()=>t.classList.add('show'));
  setTimeout(()=>{t.classList.remove('show');setTimeout(()=>t.remove(),300)},3000);
}

// Close modals on overlay click
document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', e => { if(e.target === e.currentTarget) el.classList.remove('active'); });
});

// Static event listeners
document.getElementById('logoutBtn').addEventListener('click', logout);
document.getElementById('refreshBtn').addEventListener('click', refreshActiveTab);
document.getElementById('createKeyBtn').addEventListener('click', openCreateKey);
document.getElementById('createKeyCancelBtn').addEventListener('click', () => closeModal('createKeyModal'));
document.getElementById('createKeyConfirmBtn').addEventListener('click', createApiKey);
document.getElementById('copyKeyBtn').addEventListener('click', copyKey);
document.getElementById('keyRevealDoneBtn').addEventListener('click', () => closeModal('keyRevealModal'));
document.getElementById('revokeCancelBtn').addEventListener('click', () => closeModal('confirmRevokeModal'));
document.getElementById('confirmRevokeBtn').addEventListener('click', confirmRevoke);

// Event delegation for dashboard "Create API Key" buttons
document.getElementById('tab-dashboard').addEventListener('click', e => {
  const btn = e.target.closest('.switch-to-keys');
  if (btn) switchTab('keys');
});

// Event delegation for key list buttons
document.getElementById('keyList').addEventListener('click', e => {
  const toggleBtn = e.target.closest('.toggle-key-btn');
  if (toggleBtn) toggleKey(parseInt(toggleBtn.dataset.keyId), toggleBtn.dataset.enabled === 'true');

  const revokeBtn = e.target.closest('.revoke-key-btn');
  if (revokeBtn) openRevoke(parseInt(revokeBtn.dataset.keyId), revokeBtn.dataset.keyName);
});

// Event delegation for empty state "Create Key" button
document.getElementById('keyList').addEventListener('click', e => {
  const btn = e.target.closest('.create-key-empty');
  if (btn) openCreateKey();
});

async function logout() {
  try {
    await fetch('/api/logout', { method: 'POST', headers: { Authorization: `Bearer ${TOKEN}` } });
  } catch(e) {}
  window.location.href = '/';
}

// Init
loadDashboard();
</script>
</body>
</html>