<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing - PatrolLink</title>
  <link rel="icon" href="/images/logo.png" type="image/x-icon">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      line-height: 1.6;
      min-height: 100vh;
      padding: 40px 20px 60px;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    .logo-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 48px;
    }
    .logo-bar img {
      width: 38px;
      height: 38px;
      border-radius: 10px;
    }
    .logo-bar span {
      font-size: 1.3rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.3px;
    }
    header {
      text-align: center;
      margin-bottom: 40px;
    }
    header h1 {
      font-size: 2.5rem;
      color: #fff;
      font-weight: 800;
      margin-bottom: 12px;
    }
    header p {
      color: #64748b;
      font-size: 1.1rem;
    }
    .billing-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 4px;
      margin: 0 auto 48px;
      width: fit-content;
    }
    .billing-toggle button {
      background: none;
      border: none;
      padding: 10px 20px;
      border-radius: 9px;
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .billing-toggle button:hover { color: #e2e8f0; }
    .billing-toggle button.active {
      background: #2563eb;
      color: #fff;
    }
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 48px;
    }
    .pricing-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 32px 24px;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: border-color 0.2s;
    }
    .pricing-card:hover { border-color: #475569; }
    .pricing-card.popular {
      border-color: #2563eb;
      box-shadow: 0 0 0 1px #2563eb;
    }
    .popular-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: #2563eb;
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .plan-guards {
      font-size: 0.85rem;
      color: #64748b;
      font-weight: 500;
      margin-bottom: 4px;
    }
    .plan-name {
      font-size: 1.5rem;
      color: #fff;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .price-display {
      margin-bottom: 20px;
    }
    .price-display .price {
      font-size: 2.5rem;
      color: #fff;
      font-weight: 800;
    }
    .price-display .period {
      font-size: 0.9rem;
      color: #64748b;
    }
    .price-display .savings {
      font-size: 0.8rem;
      color: #22c55e;
      margin-top: 2px;
    }
    .features-list {
      list-style: none;
      margin-bottom: 24px;
      flex-grow: 1;
    }
    .features-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #cbd5e1;
      font-size: 0.88rem;
      margin-bottom: 10px;
    }
    .features-list li svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    .btn {
      display: block;
      text-align: center;
      padding: 14px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: background 0.2s;
    }
    .btn-primary {
      background: #2563eb;
      color: #fff;
    }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary {
      background: transparent;
      color: #e2e8f0;
      border: 1.5px solid #334155;
    }
    .btn-secondary:hover { border-color: #60a5fa; }
    .btn-popular {
      background: #2563eb;
      color: #fff;
    }
    .btn-popular:hover { background: #1d4ed8; }
    .footer-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .footer-actions a {
      color: #64748b;
      font-size: 0.9rem;
      text-decoration: none;
      transition: color 0.2s;
    }
    .footer-actions a:hover { color: #94a3b8; }
    .guarantee {
      text-align: center;
      color: #475569;
      font-size: 0.85rem;
    }
    @media (max-width: 900px) {
      .pricing-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .pricing-grid { grid-template-columns: 1fr; }
      header h1 { font-size: 1.75rem; }
      .billing-toggle button { padding: 8px 14px; font-size: 0.82rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo-bar">
      <img src="/images/logo.png" alt="PatrolLink">
      <span>PatrolLink</span>
    </div>

    <header>
      <h1>Pick your plan</h1>
      <p>Choose the right guard count for your organization.</p>
    </header>

    <div class="billing-toggle" id="billingToggle">
      <button type="button" data-period="monthly" class="active">Monthly</button>
      <button type="button" data-period="quarterly">Quarterly</button>
      <button type="button" data-period="semiannual">6 Months</button>
      <button type="button" data-period="yearly">Yearly</button>
    </div>

    <div class="pricing-grid" id="pricingGrid">
      <div class="pricing-card" data-guards="20">
        <div class="plan-guards">Up to 20 guards</div>
        <div class="plan-name">Starter</div>
        <div class="price-display">
          <div class="price" data-monthly="4,500" data-quarterly="12,000" data-semiannual="22,500" data-yearly="42,000">4,500</div>
          <div class="period">per month</div>
        </div>
        <ul class="features-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Up to 20 security guards</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Real-time guard tracking</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Shift management</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Incident reporting</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Email support</li>
        </ul>
        <button type="button" class="btn btn-secondary select-plan" data-plan="starter">Choose plan</button>
      </div>

      <div class="pricing-card" data-guards="50">
        <div class="plan-guards">Up to 50 guards</div>
        <div class="plan-name">Growth</div>
        <div class="price-display">
          <div class="price" data-monthly="8,500" data-quarterly="22,500" data-semiannual="42,000" data-yearly="80,000">8,500</div>
          <div class="period">per month</div>
        </div>
        <ul class="features-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Up to 50 security guards</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Everything in Starter</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Analytics dashboard</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Patrol reports</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Priority email support</li>
        </ul>
        <button type="button" class="btn btn-secondary select-plan" data-plan="growth">Choose plan</button>
      </div>

      <div class="pricing-card popular" data-guards="100">
        <div class="popular-badge">POPULAR</div>
        <div class="plan-guards">Up to 100 guards</div>
        <div class="plan-name">Business</div>
        <div class="price-display">
          <div class="price" data-monthly="15,000" data-quarterly="40,000" data-semiannual="75,000" data-yearly="140,000">15,000</div>
          <div class="period">per month</div>
        </div>
        <ul class="features-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Up to 100 security guards</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Everything in Growth</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> WhatsApp support</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Custom reports</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> API access</li>
        </ul>
        <button type="button" class="btn btn-popular select-plan" data-plan="business">Choose plan</button>
      </div>

      <div class="pricing-card" data-guards="unlimited">
        <div class="plan-guards">Unlimited guards</div>
        <div class="plan-name">Enterprise</div>
        <div class="price-display">
          <div class="price" data-monthly="25,000" data-quarterly="67,500" data-semiannual="127,500" data-yearly="240,000">25,000</div>
          <div class="period">per month</div>
        </div>
        <ul class="features-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Unlimited security guards</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Everything in Business</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Priority 24/7 support</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Advanced analytics</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Dedicated account manager</li>
        </ul>
        <button type="button" class="btn btn-secondary select-plan" data-plan="enterprise">Choose plan</button>
      </div>
    </div>

    <div class="footer-actions">
      <a href="/api-endpoints" id="skipLink">Skip for now →</a>
      <a href="/api-endpoints" id="continueLink">Continue to API Endpoints</a>
    </div>

    <div class="guarantee">14-day money-back guarantee. No questions asked.</div>
  </div>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const rawReturnTo = urlParams.get('returnTo') || '';
    const SAFE_PATHS = ['/admin/dashboard', '/api-endpoints', '/documentation', '/paywall', '/login', '/signup'];
    const returnTo = SAFE_PATHS.includes(rawReturnTo) ? rawReturnTo : '/api-endpoints';

    document.getElementById('skipLink').href = returnTo;
    document.getElementById('continueLink').href = returnTo;

    const periods = ['monthly', 'quarterly', 'semiannual', 'yearly'];
    const periodLabels = { monthly: 'per month', quarterly: 'per quarter', semiannual: 'per 6 months', yearly: 'per year' };
    const periodSavings = { monthly: null, quarterly: 'Save 10%', semiannual: 'Save 15%', yearly: 'Save 20%' };

    document.querySelectorAll('#billingToggle button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#billingToggle button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const period = btn.dataset.period;

        document.querySelectorAll('.pricing-card').forEach(card => {
          const priceEl = card.querySelector('.price');
          const periodEl = card.querySelector('.period');
          const savingsEl = card.querySelector('.savings');
          const price = priceEl.dataset[period];
          priceEl.textContent = price;
          periodEl.textContent = periodLabels[period];
          if (savingsEl) savingsEl.remove();
          if (periodSavings[period]) {
            const s = document.createElement('div');
            s.className = 'savings';
            s.textContent = periodSavings[period];
            priceEl.parentNode.appendChild(s);
          }
        });
      });
    });

    document.querySelectorAll('.select-plan').forEach(btn => {
      btn.addEventListener('click', () => {
        const plan = btn.dataset.plan;
        const activePeriod = document.querySelector('#billingToggle .active').dataset.period;
        alert(`You selected the ${plan} plan (${activePeriod}). Payment integration coming soon.`);
        window.location.href = returnTo;
      });
    });
  </script>
</body>
</html>